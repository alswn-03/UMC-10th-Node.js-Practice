// ✅ SCHEMA.PRISMA 변경 후 수행할 단계 (체크리스트)
/*
1️⃣  schema.prisma 파일 수정
2️⃣  마이그레이션 생성 및 적용: 
    npx prisma migrate dev --name "설명적인_이름"
3️⃣  Prisma Client 자동 생성됨 (src/generated/prisma)
4️⃣  서버 재시작: npm run dev
5️⃣  변경사항 Git에 커밋 (schema.prisma + prisma/migrations/*)
*/
// ✅ 자주 쓰이는 migration 명령어
/*
- `npx prisma migrate dev`
    - 개발 단계에서 스키마를 변경할 때 사용합니다. 마이그레이션을 생성하고 적용해줍니다.
    - 새 migration이 생성되고, 로컬 DB에 바로 반영됩니다.
    - 데이터는 보존됩니다.
- `npx prisma migrate deploy`
    - 운영/테스트에 “이미 존재하는” 마이그레이션을 적용할 때 사용됩니다.
    - 새 파일을 만들지 않으며, 배포 파이프라인에서 사용합니다.
    - 데이터는 보존됩니다.
- `npx prisma db push`
    - 스키마를 “그대로” DB에 밀어 넣을 때 사용합니다. 마이그레이션 파일은 생성되지 않습니다.
    - 빠르게 실험할 때만 사용하고, 팀/운영에서는 보통 지양하는 명령어입니다.
    - 데이터는 보존됩니다.
- `npx prisma migrate reset`
    - 개발 DB를 초기화 할 때 사용합니다.
    - `migrations/*`를 순서대로 재적용하고 시드가 있다면 실행합니다.
    - 데이터는 모두 삭제됩니다.
*/

// ✅ 마이그레이션 관련 주의사항
/*
- `migrate dev` 는 반드시 Git에 커밋해서 다른 팀원들과 동기화를 시킵니다.
- 운영 환경에서는 `db push` , `reset` 사용을 지양합니다.
- 충돌 방지를 위해 PR에 `schema.prisma`와 `migrations/*`가 **세트로 들어가야** 합니다.
*/
// ✅ Prisma Client 도구
/*
- npx prisma generate
    ⚠️ 보통은 수동으로 실행할 필요가 없습니다!
    - `npx prisma migrate dev` 실행 시 자동 생성됨 ✨
    - `npx prisma db push` 실행 시 자동 생성됨 ✨
    - schema.prisma만 수정했는데 Client가 반영 안 됐을 때만 수동 실행
Prisma Client는 Prisma가 데이터베이스와 상호작용하기 위한 도구입니다. Prisma Client를 사용하면, TypeScript나 JavaScript 코드에서 데이터베이스 쿼리를 작성할 수 있습니다. Prisma Client는 Prisma Schema 파일을 기반으로 자동으로 생성되며, 데이터베이스 모델에 대한 타입 안전한 API를 제공합니다. Prisma Client를 사용하면, 데이터베이스 쿼리를 작성할 때 타입 오류를 방지할 수 있고, 코드 완성 기능을 활용하여 개발 효율성을 높일 수 있습니다. Prisma Client는 Prisma Migrate와 함께 사용되어, 데이터베이스 스키마 변경 사항을 코드에서 쉽게 반영할 수 있도록 도와줍니다.
*/

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model FoodCategory {
  id                BigInt              @id @default(autoincrement())
  name              String              @db.VarChar(50)
  userFavorCategory UserFavorCategory[]

  @@map("food_category")
}

model Mission {
  id          BigInt        @id @default(autoincrement())
  storeId     BigInt        @map("store_id")
  reward      Int
  deadline    DateTime      @db.DateTime(0)
  missionSpec String        @map("mission_spec") @db.Text
  createdAt   DateTime?     @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime?     @default(now()) @map("updated_at") @db.DateTime(0)
  store       Store         @relation(fields: [storeId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "mission_ibfk_1")
  userMission UserMission[]

  @@index([storeId], map: "store_id")
  @@map("mission")
}

model Region {
  id    BigInt  @id @default(autoincrement())
  name  String  @db.VarChar(20)
  store Store[]

  @@map("region")
}

model Review {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  storeId   BigInt    @map("store_id")
  body      String    @db.Text
  score     Float     @db.Float
  createdAt DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime? @default(now()) @map("updated_at") @db.DateTime(0)
  user      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "review_ibfk_1")
  store     Store     @relation(fields: [storeId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "review_ibfk_2")

  @@index([storeId], map: "store_id")
  @@index([userId], map: "user_id")
  @@map("review")
}

model Store {
  id       BigInt    @id @default(autoincrement())
  regionId BigInt    @map("region_id")
  name     String?   @db.VarChar(50)
  address  String?   @db.VarChar(50)
  score    Float?    @default(0) @db.Float
  mission  Mission[]
  review   Review[]
  region   Region    @relation(fields: [regionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "store_ibfk_1")

  @@index([regionId], map: "region_id")
  @@map("store")
}

model User {
  id                BigInt              @id @default(autoincrement())
  email             String              @unique(map: "email") @db.VarChar(255)
  name              String              @db.VarChar(100)
  gender            String              @db.VarChar(10)
  birth             DateTime            @db.Date
  address           String?             @db.VarChar(255)
  detailAddress     String?             @map("detail_address") @db.VarChar(255)
  phoneNumber       String?             @map("phone_number") @db.VarChar(20)
  password          String              @db.VarChar(255)
  review            Review[]
  userFavorCategory UserFavorCategory[]
  userMission       UserMission[]

  @@map("user")
}

model UserFavorCategory {
  id             BigInt        @id @default(autoincrement())
  user           User          @relation(fields: [userId], references: [id])
  userId         BigInt        @map("user_id")
  foodCategory   FoodCategory  @relation(fields: [foodCategoryId], references: [id])
  foodCategoryId BigInt        @map("food_category_id")

  @@index([foodCategoryId], map: "food_category_id")
  @@index([userId], map: "user_id")
  @@map("user_favor_category")
}

model UserMission {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  missionId BigInt    @map("mission_id")
  status    String    @default("진행중") @db.VarChar(15)
  createdAt DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime? @default(now()) @map("updated_at") @db.DateTime(0)
  user      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_mission_ibfk_1")
  mission   Mission   @relation(fields: [missionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_mission_ibfk_2")

  @@unique([userId, missionId], map: "unique_user_mission")
  @@index([missionId], map: "mission_id")
  @@map("user_mission")
}
